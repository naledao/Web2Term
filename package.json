{
  "name": "web2term",
  "productName": "Web2Term",
  "version": "0.1.197",
  "private": true,
  "description": "React + Electron desktop application (electron-vite + TypeScript)",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "npm run ripgrep:prepare && npm run electron:install",
    "dev": "electron-vite dev",
    "predev:watch": "npm run ripgrep:prepare && npm run electron:install",
    "dev:watch": "electron-vite dev --watch",
    "electron:install": "node node_modules/electron/install.js",
    "prepreview": "npm run ripgrep:prepare && npm run electron:install",
    "ripgrep:prepare": "node build/prepare-ripgrep.mjs",
    "build": "npm run typecheck && npm run ripgrep:prepare && electron-vite build && node build/build-windows-helper.mjs",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:redis": "node --experimental-strip-types --test tests/redis-reader.test.mjs",
    "test:qq-mail": "node --experimental-strip-types --test tests/qq-mail.test.mjs tests/mail-notification.test.mjs",
    "test:execution-recovery": "node --experimental-strip-types --test tests/execution-recovery.test.mjs",
    "test:mac": "node --test tests/macos-terminal.test.mjs",
    "test:ripgrep": "npm run ripgrep:prepare && node --test tests/ripgrep.test.mjs tests/shell-path.test.mjs tests/web2term-environment.test.mjs tests/prompt-injection.test.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "helper:restore": "node build/restore-windows-helper.mjs",
    "helper:publish": "node build/publish-windows-helper.mjs",
    "pack:dir": "npm run build && npm run helper:publish && electron-builder --dir",
    "dist": "npm run build && npm run helper:publish && electron-builder",
    "dist:win": "npm run build && npm run helper:publish && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "6.5.2",
    "@codemirror/search": "^6.7.2",
    "@git-diff-view/react": "^0.1.7",
    "@lezer/highlight": "^1.2.5",
    "@svar-ui/react-filemanager": "^2.6.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@uiw/react-md-editor": "^4.1.2",
    "cron-parser": "^5.10.2",
    "electron-updater": "^6.8.9",
    "ioredis": "^5.11.1",
    "katex": "^0.19.1",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.2.1",
    "react-avatar-editor": "^15.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@embedpdf/fonts-latin": "1.0.0",
    "@embedpdf/fonts-sc": "1.0.0",
    "@embedpdf/fonts-tc": "1.0.0",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/react-pdf-viewer": "2.15.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vscode/ripgrep-universal": "1.18.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
