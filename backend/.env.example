# Reference only; inject through your shell or systemd EnvironmentFile.
WEB2TERM_ADDR=:10088
WEB2TERM_DB_PATH=data/web2term.db
WEB2TERM_JWT_SECRET=

# Optional; empty disables release-note administration, while public reads remain available.
RELEASE_NOTES_ADMIN_TOKEN=

# QQ Mail: use the SMTP authorization code, not the mailbox login password.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_MODE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
